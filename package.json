{
	"name": "uar-shared",
	"version": "0.8.2",
	"description": "UAR's palette and its own Svelte components, on top of sveltekit-commons",
	"type": "module",
	"license": "MIT",
	"svelte": "./src/index.js",
	"exports": {
		".": {
			"types": "./src/index.d.ts",
			"svelte": "./src/index.js",
			"default": "./src/index.js"
		},
		"./palette.css": "./src/palette.css",
		"./ready": {
			"types": "./src/ready.d.ts",
			"default": "./src/ready.js"
		},
		"./presence": {
			"types": "./src/presence.d.ts",
			"default": "./src/presence.js"
		}
	},
	"files": [
		"src"
	],
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"sveltekit-commons": "git+https://github.com/Geptyro/sveltekit-commons.git#semver:^0.6.0"
	}
}
